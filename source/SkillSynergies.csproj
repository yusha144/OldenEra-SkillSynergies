<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><LangVersion>latest</LangVersion>
    <AssemblyName>OldenEra.SkillSynergies</AssemblyName><Version>0.1.15</Version>
    <Description>Olden Era Skill Synergies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(GameRoot)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(GameRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Hex"><HintPath>$(GameRoot)\BepInEx\interop\Hex.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Hex.Shared"><HintPath>$(GameRoot)\BepInEx\interop\Hex.Shared.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Hex.Utils"><HintPath>$(GameRoot)\BepInEx\interop\Hex.Utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GameRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRoot)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameRoot)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameRoot)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameRoot)\BepInEx\interop\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameRoot)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateGameRoot" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameRoot)' == ''" Text="Set GameRoot to your own Olden Era installation: -p:GameRoot=path" />
    <Error Condition="!Exists('$(GameRoot)/BepInEx/interop/Hex.dll')" Text="BepInEx interop is missing. Run the supported game with BepInEx once, then close it." />
  </Target>
</Project>
